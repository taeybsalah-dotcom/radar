<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="sadeemGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981" />
      <stop offset="50%" stop-color="#059669" />
      <stop offset="100%" stop-color="#0EA5E9" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#059669" flood-opacity="0.35" />
    </filter>
  </defs>

  <!-- Background Card -->
  <rect width="512" height="512" rx="128" fill="url(#sadeemGrad)" filter="url(#shadow)" />
  
  <!-- Subtle Inner Ring -->
  <rect x="16" y="16" width="480" height="480" rx="112" fill="none" stroke="rgba(255, 255, 255, 0.2)" stroke-width="4" />

  <!-- Arabic Typography: سديم الأثر -->
  <g fill="#FFFFFF" text-anchor="middle" font-family="'Tajawal', 'Cairo', 'Segoe UI', sans-serif">
    <!-- سديم -->
    <text x="256" y="240" font-size="110" font-weight="900" letter-spacing="-2">سديم</text>
    <!-- الأثر -->
    <text x="256" y="360" font-size="95" font-weight="800" letter-spacing="1">الأثـر</text>
  </g>

  <!-- Modern Tech Sparkle Accent -->
  <circle cx="390" cy="130" r="14" fill="#FCD34D" />
  <circle cx="410" cy="150" r="7" fill="#FCD34D" opacity="0.8" />
</svg>
