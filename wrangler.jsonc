{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "myradar.sarl/*",
      "zone_name": "myradar.sarl",
      "custom_domain": true
    },
    {
      "pattern": "www.myradar.sarl/*",
      "zone_name": "myradar.sarl",
      "custom_domain": true
    }
  ],
  "env": {
    "production": {
      "name": "radar",
      "routes": [
        {
          "pattern": "myradar.sarl/*",
          "zone_name": "myradar.sarl",
          "custom_domain": true
        },
        {
          "pattern": "www.myradar.sarl/*",
          "zone_name": "myradar.sarl",
          "custom_domain": true
        }
      ]
    },
    "staging": {
      "name": "radar-staging",
      "routes": [
        {
          "pattern": "staging.myradar.sarl/*",
          "zone_name": "myradar.sarl",
          "custom_domain": true
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}
